{
  "name": "wine-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "next build && node scripts/build-sites-static-worker.mjs",
    "start": "next start",
    "lint": "next lint",
    "migrate:wines": "node scripts/migrate-wine-catalog.mjs",
    "scan:seagrape": "node scripts/scan-seagrape-pdfs.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.mts",
    "cf:typecheck": "tsc -p worker/tsconfig.json",
    "cf:preview": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.114.0"
  }
}
